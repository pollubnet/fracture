@using Fracture.Server.Modules.MapGenerator.Models.Map
@using Fracture.Server.Modules.MapGenerator.Models.Map.MapObjects

<div class="node-info">
    <span>Biome: @Node.Biome.Name</span>
    @if (!string.IsNullOrWhiteSpace(Node.GroupName)) 
    {
        <span>Location: @Node.GroupName</span>
    }
    @if (Node.ItemDrop is not null)
    {
        <span>Item: @Node.ItemDrop.Id</span>
    }
    @if (HasItemDrop)
    {
        <span>Item: Unknown item!</span>
    }
    @if (Node.MapObject is NpcMapObject npc)
    {
        <span>NPC: @npc.Id</span>
    }
    @if (!Node.Walkable)
    {
        <span>Not walkable!</span>
    }
</div>

@code {
    [Parameter] public required Node Node { get; set; }
    [Parameter] public bool HasItemDrop { get; set; } = false;
}