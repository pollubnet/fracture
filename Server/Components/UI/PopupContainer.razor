@using Fracture.Server.Components.Pages
@rendermode InteractiveServer

<div class="popup @(IsVisible ? "" : "hidden")">
	@if (CurrentPopup is not null)
	{
		<DynamicComponent Type="@CurrentPopup.ComponentType" Parameters="@CurrentPopup.Parameters" @ref="Component" />
	}
	<div>
		<button class="closeBtn" @onclick="Hide"><img src="assets/icons/closebutton.svg" /></button>
	</div>
</div>

@code {
	public bool IsVisible { get; set; }
	private Stack<PopupState> _popupStack = new();

	public DynamicComponent? Component = null;

	public PopupState? CurrentPopup => _popupStack.Count > 0 ? _popupStack.Peek() : null;

	public void ShowComponent<T>(IDictionary<string, object>? parameters = null)
	{
		var newComponentType = typeof(T);
		
		// Sprawdź czy ten typ już istnieje na stosie
		if (_popupStack.Any(p => p.ComponentType == newComponentType))
		{
			// Jeśli już istnieje, nie dodawaj nowego
			return;
		}
		
		// Pokaż nowy popup
		var newPopup = new PopupState 
		{ 
			ComponentType = newComponentType, 
			Parameters = parameters 
		};
		
		_popupStack.Push(newPopup);
		IsVisible = true;
		StateHasChanged();
	}

	public void Hide()
	{
		// Usuń bieżący popup ze stosu
		if (_popupStack.Count > 0)
		{
			_popupStack.Pop();
		}

		// Pokaż poprzedni popup lub ukryj
		IsVisible = _popupStack.Count > 0;
		StateHasChanged();
	}

	// Klasa pomocnicza do przechowywania stanu popupu
	public class PopupState
	{
		public required Type ComponentType { get; set; }
		public IDictionary<string, object>? Parameters { get; set; }
	}
}