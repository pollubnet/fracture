@using Fracture.Server.Modules.Npc.Models

<div class="item-popup">
	<h3 class="item-popup-h3">You have met somebody! <br /> Do you want to talk?</h3>
	<div class="item-title">
		<strong>@Npc.Name</strong>
	</div>

	<div class="popup-actions">
		<div @onclick="ConfirmAsync" class="btn">
			<div class="btn-content">
				Yes
			</div>

		</div>
		<div @onclick="CancelAsync" class="btn">
			<div class="btn-content">
				No
			</div>
		</div>
	</div>
</div>

@code {
	[Parameter] public required NpcEntity Npc { get; set; }
	[Parameter] public Func<Task>? OnConfirm { get; set; }
	[Parameter] public Func<Task>? OnCancel { get; set; }

	private async Task ConfirmAsync()
	{
		if (OnConfirm is not null)
			await OnConfirm();
	}

	private async Task CancelAsync()
	{
		if (OnCancel is not null)
			await OnCancel();
	}
}