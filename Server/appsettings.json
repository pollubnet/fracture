{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "UseAI": false
  },
  "SerialPort": {
    "PortName": "COM4",
    "BaudRate": 115200,
    "WriteTimeoutMs": 3000
  },
